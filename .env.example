# Exemplo de configuracao. Copie para .env e ajuste os valores.
# Nenhum segredo real deve ser versionado: os valores abaixo sao placeholders.

APP_NAME=Real-time Event Ingestion & Data Quality Engine
APP_VERSION=1.0.0
ENVIRONMENT=local

# Banco de dados (async SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://dq:CHANGE_ME@postgres:5432/dq
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Senha usada pelo docker-compose (postgres + DATABASE_URL da API)
POSTGRES_PASSWORD=CHANGE_ME

# OpenTelemetry
OTEL_SDK_DISABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
OTEL_SERVICE_NAME=data-quality-engine

# Motor de Data Quality
STRICT_MODE=false
FUTURE_TIMESTAMP_TOLERANCE_SECONDS=300
RETENTION_WINDOW_DAYS=30
TEMPERATURE_MIN=-90.0
TEMPERATURE_MAX=60.0
HUMIDITY_MIN=0.0
HUMIDITY_MAX=100.0
VALUE_MIN=0.0
MAX_STRING_LENGTH=512
MAX_ENVELOPE_STRING_LENGTH=128
DEDUP_WINDOW_SIZE=10000

# Limites de requisicao
MAX_BATCH_SIZE=1000

# Observabilidade local
LOG_LEVEL=INFO
